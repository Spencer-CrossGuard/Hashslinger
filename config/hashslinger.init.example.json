{
  "install_root": "C:\\Hashslinger",

  "paths": {
    "store": "D:\\Hashslinger\\store",
    "staging": "D:\\Hashslinger\\staging",
    "logs": "C:\\Hashslinger\\logs",
    "output": "D:\\Hashslinger\\output",
    "status": "C:\\Hashslinger\\status",
    "requests": "C:\\Hashslinger\\requests"
  },

  "ad": {
    "mode": "live",
    "domain_controller": "DC1.corp.contoso.com",
    "target_ous": ["OU=Finance,DC=corp,DC=contoso,DC=com"],
    "account_types": ["User", "Service"],
    "uac_exclude_flags": ["SMARTCARD_REQUIRED"],
    "replication": "bulk",
    "ntds_path": "",
    "system_hive_path": ""
  },

  "scan": {
    "check_duplicates": false,
    "cadence": "Weekly",
    "retention_days": 90,
    "engine_timeout_seconds": 86400
  },

  "security": {
    "gmsa_name": "svc-hashslinger",
    "run_server": "SCANHOST01",
    "analyst_group": "HS-Analysts",
    "authorized_edipis": [],
    "require_encrypted_volume": false
  },

  "wordlists": {
    "hibp": "",
    "rockyou": "",
    "custom": ""
  },

  "dsinternals_offline_path": "",
  "min_free_space_gb": { "store": 60, "output": 5 }
}
